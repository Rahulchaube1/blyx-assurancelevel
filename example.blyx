use assurancelevel;

fn main() {
    let observed = 2.0;
    let required = 2.0;
    let auth_time = 90.0;
    let now = 100.0;
    let max_age = 10.0;
    let result = assurancelevel_policy(observed, required, auth_time, now, max_age);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
